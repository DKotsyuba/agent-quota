# Root-owned, nonsecret settings for one source; replace every placeholder.
AQ_BINARY=/usr/local/bin/agent-quota
AQ_CONFIG=/etc/agent-quota/config.toml
AQ_SOCKET=/var/lib/agent-quota/quota.sock
AQ_SERVICE_USER=quota-service
AQ_SERVICE_TMP=/var/lib/agent-quota/tmp
AQ_PROBE_USER=quota-owner
AQ_PROBE_OS_HOME=/home/quota-owner
AQ_PROBE_PRIVATE_HOME=/home/quota-owner/.agent-quota-probe
AQ_PROBE_TMP=/home/quota-owner/.agent-quota-probe/tmp
AQ_PROBE_PATH=/usr/local/bin:/usr/bin:/bin
AQ_ACCOUNT=account-example
AQ_PROVIDER=codex
AQ_SOURCE=codex-appserver
